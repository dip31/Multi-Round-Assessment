# ── Runtime environment ───────────────────────────────────────────────
# "production" enforces strict requirements (PostgreSQL, secure keys).
# "development" (default) allows looser local defaults.
APP_ENV=development

# ── Deployment Mode ────────────────────────────────────────────────────
# REQUIRED: Must be explicitly set to "demo" or "production"
# demo      = synchronous resume processing, local temp files (/tmp/edi5/), no Celery/Redis/GCS required for resumes
# production = asynchronous Celery + Redis + GCS (existing architecture)
DEPLOYMENT_MODE=demo

# ── Database ──────────────────────────────────────────────────────────
# PostgreSQL is the only supported database for the application.
DATABASE_URL=postgresql://postgres:password@localhost/ai_placement_platform
# Connection-pool tuning (conservative defaults; scale up for multiple instances)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Production hardening (Stage 2). All optional — only used when set.
# libpq sslmode applied via connect_args when non-empty:
#   disable | allow | prefer | require | verify-ca | verify-full
DB_SSL_MODE=
# Per-statement timeout in milliseconds, applied on every connection checkout.
# 0 disables. Set e.g. 30000 (30s) so runaway queries cannot hold a pool slot.
DB_STATEMENT_TIMEOUT_MS=0

# ── JWT / Auth ────────────────────────────────────────────────────────
# CRITICAL: Generate a secure random key using:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_KEY_MINIMUM_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ── CORS (JSON array) ────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174","http://localhost:5175"]

# ── Interview Round (Groq, Sarvam, Redis) ─────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
SARVAM_API_KEY=your-sarvam-api-key-here
# ── Async resume upload (Stage 6A) ────────────────────────────────────
# Hard size cap enforced on every async resume upload (bytes). Default 10 MiB.
# Override per deployment if your candidates submit larger PDFs.
MAX_RESUME_SIZE_BYTES=10485760

# ── Redis ────────────────────────────────────────────────────────────
# Redis is used in TWO roles with DIFFERENT reliability implications:
#
#   1) Optional caches (interview question rephrase cache, Sarvam TTS cache):
#      If Redis is unavailable, these caches silently degrade — the existing
#      synchronous assessment flow continues to work without speed-ups.
#
#   2) Celery broker / result backend (load-bearing for asynchronous jobs):
#      Stage 4 onwards, ALL background jobs (e.g. async resume parsing in
#      Stage 6) require a reachable Redis. If Redis is down:
#         - normal cache-dependent functionality may degrade (no impact on correctness)
#         - background jobs CANNOT be queued or executed
#         - The resume async pipeline will not be able to enqueue/start jobs.
#      Celery is configured with broker_connection_retry_on_startup=True so a
#      misconfigured broker makes the worker FAIL to start (loud failure)
#      rather than silently no-oping tasks.
#
# DEMO MODE: Redis is NOT required for resume processing (Celery disabled).
# PRODUCTION MODE: Redis IS required for Celery broker/result backend.
#
# Local dev default works against a local redis server. In production point
# this at your managed Redis (or the docker-compose service name).
#   Local:        redis://localhost:6379
#   With TLS:     rediss://redis.example.com:6379/0
#   Auth:         redis://:password@redis-host:6379/0
REDIS_URL=redis://localhost:6379

# ── Coding Round (Judge0) ─────────────────────────────────────────────
# Remote Judge0 CE server on Google Cloud VM
# For self-hosted: set JUDGE0_URL=http://35.207.238.3:2358 and JUDGE0_AUTH_MODE=self-hosted
JUDGE0_URL=http://35.207.238.3:2358
JUDGE0_API_KEY=
JUDGE0_HTTP_TIMEOUT=30
JUDGE0_AUTH_MODE=self-hosted
# Language mapping: frontend language value -> Judge0 language_id
# Python 3=71, JavaScript (Node.js)=63, Java=62, C++=54
JUDGE0_LANGUAGE_MAP={"python":71,"javascript":63,"java":62,"cpp":54}

# ── Celery (Stage 4) ────────────────────────────────────────────────
# Broker/backend default to REDIS_URL when left empty.
# DEMO MODE: Not required (Celery disabled for resume processing)
# PRODUCTION MODE: REQUIRED for async resume processing
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# Set to true only for unit tests / local dev to run tasks synchronously
# MUST be false in production (DEPLOYMENT_MODE=production)
CELERY_TASK_ALWAYS_EAGER=false

# ── Object storage (Stage 5) ────────────────────────────────────────
# Backend used by app.services.storage.get_storage_client().
# none   = disabled (existing synchronous resume flow unchanged). DEFAULT for development.
# minio  = S3-compatible MinIO (local development / rollback).
# gcs    = Google Cloud Storage / Firebase Storage (PRODUCTION).
# In production (APP_ENV=production) STORAGE_BACKEND must NOT be 'none'.
# DEMO MODE: Resumes use local /tmp storage regardless of this setting.
#            Audio/Reports still use configured backend if available.
STORAGE_BACKEND=none
# When STORAGE_BACKEND=minio, configure these:
#   Run a local MinIO for dev:
#     docker run -d --name minio -p 9000:9000 -p 9001:9001 \
#       -e MINIO_ROOT_USER=placement -e MINIO_ROOT_PASSWORD=placement123 \
#       minio/minio server /data --console-address ":9001"
#   (The console UI is then available at http://localhost:9001)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Set true when MinIO is fronted by TLS (production).
MINIO_SECURE=false
MINIO_REGION=

# ── Google Cloud Storage / Firebase Storage (production backend) ───
# Used when STORAGE_BACKEND=gcs. ONE physical bucket; the logical areas
# resumes/ audio/ reports/ are key PREFIXES inside it.
# DEMO MODE: Not required for resume processing (uses local /tmp).
#            Required if audio/reports features are used.
# PRODUCTION MODE: REQUIRED for resume, audio, and reports storage.
GCS_BUCKET_NAME=your-firebase-bucket.firebasestorage.app
# Optional explicit project id (inferred from service account when empty).
GCS_PROJECT_ID=
# Preferred on Render: paste the FULL contents of the service-account JSON
# file into this single environment variable/Secret. NEVER commit the JSON
# file to Git and NEVER log this value.
GCS_CREDENTIALS_JSON=
# Alternative for local dev only: path to a downloaded key file.
GCS_CREDENTIALS_FILE=
# Bucket names segregated by object kind; created on first write.
# With STORAGE_BACKEND=gcs these act as key prefixes inside GCS_BUCKET_NAME.
STORAGE_RESUMES_BUCKET=resumes
STORAGE_AUDIO_BUCKET=audio
STORAGE_REPORTS_BUCKET=reports

# ──────────────────────────────────────────────────────────────────────
# DEMO DEPLOYMENT EXAMPLE
# ──────────────────────────────────────────────────────────────────────
# APP_ENV=production
# DEPLOYMENT_MODE=demo
# DATABASE_URL=postgresql://user:pass@host:5432/db
# SECRET_KEY=your-secure-random-key-32-chars-minimum
# GROQ_API_KEY=your-groq-api-key
# 
# NOT REQUIRED for demo resume processing:
# REDIS_URL=
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
# STORAGE_BACKEND=
# GCS_BUCKET_NAME=
# GCS_CREDENTIALS_JSON=
#
# Render services needed:
#   - Web Service (FastAPI)
#   - PostgreSQL
#   (Redis optional, only if using interview rephrase cache or TTS cache)

# ──────────────────────────────────────────────────────────────────────
# PRODUCTION DEPLOYMENT EXAMPLE
# ──────────────────────────────────────────────────────────────────────
# APP_ENV=production
# DEPLOYMENT_MODE=production
# DATABASE_URL=postgresql://user:pass@host:5432/db
# SECRET_KEY=your-secure-random-key-32-chars-minimum
# GROQ_API_KEY=your-groq-api-key
# REDIS_URL=redis://:password@redis-host:6379/0
# CELERY_BROKER_URL=redis://:password@redis-host:6379/0
# CELERY_RESULT_BACKEND=redis://:password@redis-host:6379/0
# CELERY_TASK_ALWAYS_EAGER=false
# STORAGE_BACKEND=gcs
# GCS_BUCKET_NAME=your-firebase-bucket.firebasestorage.app
# GCS_PROJECT_ID=your-gcp-project
# GCS_CREDENTIALS_JSON={"type":"service_account",...}
#
# Render services needed:
#   - Web Service (FastAPI)
#   - Background Worker (Celery): python scripts/start_celery_worker.py
#   - Redis
#   - PostgreSQL