# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost/ai_placement_platform

# ── JWT / Auth ────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── CORS (JSON array) ────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── Judge0 Code Execution ─────────────────────────────────────────────
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=
JUDGE0_MAX_POLL_ATTEMPTS=30
JUDGE0_POLL_INTERVAL_SECONDS=1.0

# ── Coding Round Configuration ────────────────────────────────────────
CODING_ROUND_TIME_LIMIT_MINUTES=90
CODING_ROUND_PROBLEMS_COUNT=3

